APP_ENV=development
APP_BASE_URL=https://platform.allfatherbi.com

DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

APP_MASTER_KEY=

# The scheduler tick's only authority. Set EITHER of these, never both in a live deployment:
#   SCHEDULER_TOKEN       the token itself
#   SCHEDULER_TOKEN_HASH  its sha256 — PREFERRED, because a read of this file then yields nothing
#                         that can be presented. The digest wins if both are set.
# Unset means the tick is unreachable, not open. Generate with:
#   php -r 'echo rtrim(strtr(base64_encode(random_bytes(32)), "+/", "-_"), "=") . PHP_EOL;'
SCHEDULER_TOKEN=
SCHEDULER_TOKEN_HASH=

# Tick bounds. Both are clamped by the runner's own ceilings, so raising them past those does
# nothing — the bound is a property of the design, not of this file.
SCHEDULER_MAX_JOBS_PER_TICK=10
SCHEDULER_BUDGET_MS=20000
SCHEDULER_LEASE_SECONDS=300

# Provider credentials are tenant/runtime secrets and MUST NOT be committed.
