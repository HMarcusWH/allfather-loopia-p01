# development | testing | staging | production.
# ANY OTHER VALUE — a typo, an empty string, an unset key — resolves to production, because the
# cost of treating a development box as production is a few required keys and the cost of the
# inverse is a production deployment with every check switched off by a typo.
# staging and production additionally REQUIRE DB_NAME, DB_USER and a valid APP_MASTER_KEY at boot,
# and may only be configured from .env — never from the .env.testing beside it.
APP_ENV=production
APP_BASE_URL=https://platform.allfatherbi.com

DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

APP_MASTER_KEY=

# The scheduler tick's only authority. Set EITHER of these, never both in a live deployment:
#   SCHEDULER_TOKEN       the token itself
#   SCHEDULER_TOKEN_HASH  its sha256 — PREFERRED, because a read of this file then yields nothing
#                         that can be presented. The digest wins if both are set.
# Unset means the tick is unreachable, not open. Generate with:
#   php -r 'echo rtrim(strtr(base64_encode(random_bytes(32)), "+/", "-_"), "=") . PHP_EOL;'
SCHEDULER_TOKEN=
SCHEDULER_TOKEN_HASH=

# Tick bounds. Both are clamped by the runner's own ceilings, so raising them past those does
# nothing — the bound is a property of the design, not of this file.
SCHEDULER_MAX_JOBS_PER_TICK=10
SCHEDULER_BUDGET_MS=20000
SCHEDULER_LEASE_SECONDS=300

# What the authenticated Help & support page tells a beta partner about reaching a human. FREE TEXT
# an operator writes, rendered escaped, and deliberately NOT an invented default: a support page
# that names an address nobody reads is worse than one that says no contact is configured.
# Never put a credential, an internal hostname or a tenant identifier here — this string is shown
# to every signed-in user of the deployment.
SUPPORT_CONTACT_TEXT=

# The exact release this deployment is running, shown on the support page so a partner's report and
# an operator's build agree about which code produced it. The deployment runbook writes it; it is a
# git SHA or tag and nothing else.
APP_RELEASE_REF=

# Provider credentials are tenant/runtime secrets and MUST NOT be committed.
