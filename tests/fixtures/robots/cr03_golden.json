      "product_token": "LoopiaAllfather",
      "expected_rfc": "ALLOW",
      "expected_reason": "ROBOTS_NO_MATCH_DEFAULT_ALLOW",
      "expected_rule": null
    },
    {
      "id": "utf8_percent",
      "robots": "User-agent: LoopiaAllfather\nDisallow: /pricing/caf%C3%A9\n",
      "target_path": "/pricing/café",
      "product_token": "LoopiaAllfather",
      "expected_rfc": "DISALLOW",
