      "expected_rule": null
    },
    {
      "id": "no_applicable_group",
      "robots": "User-agent: OtherBot\nDisallow: /pricing/\n",
      "target_path": "/pricing/test",
      "product_token": "LoopiaAllfather",
      "expected_rfc": "ALLOW",
      "expected_reason": "ROBOTS_NO_MATCH_DEFAULT_ALLOW",
      "expected_rule": null
    },
    {
      "id": "invalid_line_ignored",
      "robots": "Invalid unparseable text\nUser-agent: LoopiaAllfather\nDisallow: /pricing/private\n",
      "target_path": "/pricing/private",
      "product_token": "LoopiaAllfather",
