# The public document root — the ONLY directory a web server should ever be pointed at.
#
# This file is DEFENCE IN DEPTH, never the boundary itself. The boundary is the deployment layout:
# the application, its configuration and its migrations live OUTSIDE the served directory, so a
# misread rule here cannot expose them because they are not reachable to begin with. A deployment
# whose safety depends on these directives being interpreted correctly has already gone wrong; see
# the deployment runbook for the layout that makes them a second line rather than the first.
#
# Every directive is guarded by <IfModule>. On a host missing the module the guard is a silent
# no-op, which is exactly why none of them may be load-bearing on their own.

# No directory listings, and no content negotiation guessing an extension onto a path.
Options -Indexes -MultiViews

# Dotfiles are never served. `.env` is the one that matters and it does not belong here at all, but
# a rule that only names `.env` would miss the next one.
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # The entry points and the intentionally public asset tree are served as themselves. Everything
  # else — every console path, and anything a caller invents — is the front controller's to answer,
  # including its 404: a 404 rendered by the application carries the same security headers every
  # other application response does, while the server's default error page carries none of them.
  RewriteRule ^(assets/.*|index\.php|scheduler\.php)$ - [L]

  # PRIVATE RELEASE NAMESPACES, refused HERE rather than being handed to the front controller.
  #
  # The catch-all below sends every unmatched path to index.php, and index.php resolves
  # configuration (`Bootstrap::load`) before it decides anything about routing — including the 404
  # it would otherwise answer. Before secrets are placed (Gate D of `docs/BETA_RUNBOOK.md`, the
  # state this rule exists for), that bootstrap always fails, so a caller-invented path and a probe
  # of `/app/autoload.php` were indistinguishable: BOTH answered 503. Gate E.2 requires 403 or 404,
  # never 200 — and, as the incident this rule closes showed, never 503 either.
  #
  # Matched by REQUEST PATH, not by file existence: none of these directories exist inside
  # `public_html/` on a correct deployment (`docs/DEPLOYMENT_RUNBOOK.md` §2), and the failure this
  # closes happens before any file is looked up. Keep this list aligned with
  # `tests/foundation/deployment_boundary.php`'s private-directory list — that test asserts
  # membership in both directions, so an addition to one without the other fails the suite.
  RewriteRule ^(app|database|docs|frontend|ops|storage|tests|worker|vendor|node_modules|config|\.git|\.github)(/|$) - [F,L]

  # SENSITIVE ROOT FILENAMES — the same reasoning, for the sibling files the deployed layout carries
  # beside `public_html/` rather than a directory.
  RewriteRule ^(composer\.json|upstream\.lock\.json|deployment-evidence\.json|BOOTSTRAP\.md|PROJECT_BOUNDARY\.md|UPSTREAM_AUTHORITY\.md|README\.md)$ - [F,L]

  RewriteRule ^ index.php [L]
</IfModule>

# Static assets are served by the web server itself, so the application's own headers never touch
# them. PR5 adds content-hashed local JS/CSS/SVG below assets/operator-console/; the directives were
# already shaped for those types and do not need to widen the public route set.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|svg|png|jpg|jpeg|woff2?)$">
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
  </FilesMatch>
</IfModule>
